// Переменные скрипта. Третий аргумент — начальное значение (строкой).
// globalVar видна и другим скриптам (GetValueFromScript), localVar — только этому.
//
// Значения localVar живут в сохранении: TScript.SaveState пишет их в SAV,
// TScript.LoadState восстанавливает ПО ИМЕНАМ. Отсюда два следствия, на
// которых держится итерация без новой игры (docs/FAST_ITERATION.md):
//   * переменную, которой больше нет в .scr, загрузка просто пропустит
//     (в лог уйдёт Warning.Script.GameLoad variable not found);
//   * новая переменная получит начальное значение из .scr;
//   * а вот СТАРОЕ значение переживёт загрузку — поэтому диагностические
//     флаги нужно уметь выключить из кода, а не только из исходника.

// Диагностика. 0 — выключено (нормальный режим).
// 1 — в меню ЛЮБОЙ станции появляются пункты вида "probe: type=SB start=0
//     now=301", а в новостях — сообщение о создании экземпляра скрипта.
// По start видно, каким путём скрипт ожил: 0 — BV/OnStart при генерации
// партии (тогда now=301: один ход до цикла + 300 прогревочных); равен ходу
// сохранения — BV/OnLoad при загрузке.
// Включать, когда диалог на Научной базе не появляется или нужно проверить
// подхват правок старым сохранением. После проверки вернуть в "0".
globalVar("vProbe", "int", "1");

// Строковый тип станции, на которой сидит игрок. Заполняется в onDialogBegin.
localVar("vStationType", "str", "");

// Ход, на котором создан текущий экземпляр скрипта. Заполняется в onInit.
localVar("vStartTurn", "int", "0");
