// Переменные скрипта. Третий аргумент — начальное значение (строкой).
// globalVar видна и другим скриптам (GetValueFromScript), localVar — только этому.

// Диагностика. 0 — выключено (нормальный режим).
// 1 — в меню ЛЮБОЙ станции появляется пункт вида "[SB probe] type=SB",
//     который показывает, что реально вернула функция ShipType.
// Включать только если диалог на Научной базе не появляется.
// СЕЙЧАС ВКЛЮЧЕНА (радиодиагностика): после проверки в игре вернуть в "0".
globalVar("vProbe", "int", "1");

// Строковый тип станции, на которой сидит игрок. Заполняется в onDialogBegin.
localVar("vStationType", "str", "");
