// Функции, которые вызывает сама игра (имена фиксированы):
//   onInit        — при создании экземпляра скрипта;
//   onTurn        — каждый игровой ход, пока экземпляр жив;
//   onDialogBegin — при открытии диалога (станции, планеты, корабля);
//   onGlobal      — в конце генерации партии и при входе игрока на экраны
//                   (планета, ангар, разговор на станции, прыжок, аркада),
//                   но ТОЛЬКО для шаблонов без активного экземпляра:
//                   RunGlobalScriptsForContext перебирает
//                   CollectInactiveScriptTemplates.
// Пустому телу нужен хотя бы комментарий "//;".
//
// Основной запуск скрипта теперь делает сам движок из CFG/Main.txt:
// BV/OnStart — при создании новой партии, BV/OnLoad — при каждой загрузке
// сохранения. onGlobal ниже оставлен запасным путём. Подробности и цепочка
// вызовов в движке: docs/FAST_ITERATION.md.

export function onInit() {
    // Ход, на котором создан этот экземпляр. Диагностика показывает его в
    // пункте меню станции: на новой партии это 0 (BV/OnStart выполняется на
    // этапе 16 генерации, до прогревочных ходов, а CurrentTurn тогда ещё 0),
    // на загруженном сохранении — ход этого сохранения (экземпляр поднят
    // BV/OnLoad либо запасным onGlobal). Так видно, каким путём скрипт ожил:
    // start=0 now=301 — новая партия, start=0 now=<ход> — экземпляр достался
    // из сохранения, start=now=<ход> — экземпляр создан при загрузке.
    vStartTurn = CurTurn();

    if (vProbe) {
        Ether(0, '', Format("SbHello: экземпляр создан на ходу <0>", "<0>", vStartTurn));
    }
}

export function onTurn() {
    //;
}

export function onDialogBegin() {
    // ДИАГНОСТИКА (vProbe = 1). Вне всех условий: если этот пункт появится
    // в любом диалоге — значит onDialogBegin вообще вызывается. Сам текст
    // показывает, что вернула GetShipRuins(Player()).
    if (vProbe) {
        AddDialogInject('DialogSbProbe', '', Format("probe: ruins=<0>", "<0>", GetShipRuins(Player())), 1);
    }

    if (GetShipRuins(Player()) > 0) {
        vStationType = ShipType(GetShipRuins(Player()));

        // ДИАГНОСТИКА: реальный ShipType любой станции (внутри условия > 0)
        // плюс ход создания экземпляра и текущий ход. Format заменяет пары
        // (что, на что) по очереди; нечётное число пар обязательно, иначе
        // последний аргумент движок сочтёт цветом.
        if (vProbe) {
            AddDialogInject('DialogSbProbe', '', Format("probe: type=<0> start=<1> now=<2>", "<0>", vStationType, "<1>", vStartTurn, "<2>", CurTurn()), 1);
        }

        // 'SB' — строковый тип Научной базы. Полная таблица движка
        // (ShipTypeNames, aConst.pas:381, индексируется TShipType из
        // aGalaxyStruct.pas:75): 6=RC центр рейнджеров, 7=PB пиратская база,
        // 8=WB военная база, 9=SB научная база, 10=BK бизнес-центр,
        // 11=MC медбаза, 12=CB Доминион, 13=UB кастомная станция.
        // 'CB' в первой версии попал сюда из примера чужого мода и ошибочно
        // считался «вариантом научной базы» — на самом деле это отдельный тип
        // (Доминион), так что теперь пункт только на Научной базе.
        //
        // AddDialogInject добавляет пункт в текущее меню станции, а первый
        // аргумент — имя диалога, который запустится по клику (не цель
        // инъекции).
        if (vStationType == 'SB') {
            AddDialogInject('DialogSbHello', '', "Спросить о текущих исследованиях", 1);
        }
    }
}

export function onGlobal() {
    // Запасной запуск. GRun() просит движок создать экземпляр этого шаблона:
    // он просто ставит ScriptTemplateStartRequested, а запускает
    // RunGlobalScriptsForContext — и только для неактивных шаблонов.
    //
    // Guard "if (!GCntRun(GScriptName))" здесь НЕ нужен и вреден. GCntRun
    // возвращает UseCount шаблона, который переживает удаление экземпляра и
    // сохраняется в SAV, поэтому однажды сработав, guard навсегда запрещал
    // перезапуск: движок удалил экземпляр без привязанных кораблей — и мод
    // терял пункты меню до конца партии (так было в первой версии).
    //
    // SbGroup по-прежнему держит привязку игрока (countMin/countMax = 1,
    // addPlayer = true), чтобы экземпляр вообще не удаляли после хода.
    GRun();

    // ДИАГНОСТИКА: сообщение на панели уведомлений доказывает, что сработал
    // именно запасной путь (основной — BV/OnStart и BV/OnLoad из CFG/Main.txt).
    if (vProbe) {
        Ether(0, '', "SbHello: onGlobal -> GRun, запасной запуск скрипта");
    }
}
