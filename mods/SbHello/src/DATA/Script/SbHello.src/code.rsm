// Функции, которые вызывает сама игра (имена фиксированы):
//   onInit        — при старте скрипта в новой игре;
//   onTurn        — каждый игровой ход;
//   onDialogBegin — при открытии диалога (станции, планеты, корабля);
//   onGlobal      — каждый ход независимо от состояния скрипта.
// Пустому телу нужен хотя бы комментарий "//;".

export function onInit() {
  //;
}

export function onTurn() {
  //;
}

export function onDialogBegin() {
    // ДИАГНОСТИКА (vProbe = 1). Вне всех условий: если этот пункт появится
    // в любом диалоге — значит onDialogBegin вообще вызывается. Сам текст
    // показывает, что вернула GetShipRuins(Player()).
    if (vProbe) {
        AddDialogInject('DialogSbProbe', '', Format("probe: ruins=<0>", "<0>", GetShipRuins(Player())), 1);
    }

    if (GetShipRuins(Player()) > 0) {
        vStationType = ShipType(GetShipRuins(Player()));

        // ДИАГНОСТИКА: реальный ShipType любой станции (внутри условия > 0).
        if (vProbe) {
            AddDialogInject('DialogSbProbe', '', Format("probe: type=<0>", "<0>", vStationType), 1);
        }

        // 'SB' — строковый тип Научной базы. AddDialogInject добавляет пункт
        // в текущее меню станции, а первый аргумент — имя диалога, который
        // запустится по клику (не цель инъекции).
        if (vStationType == 'SB' || vStationType == 'CB') {
            AddDialogInject('DialogSbHello', '', "Спросить о текущих исследованиях", 1);
        }
    }
}

export function onGlobal() {
    // Стартуем один раз за партию. SbGroup должен держать привязку игрока:
    // иначе движок удалит экземпляр без кораблей, а этот guard уже не даст
    // запустить его повторно и onDialogBegin перестанет добавлять пункты меню.
    if (!GCntRun(GScriptName)) {
        GRun();

        // ДИАГНОСТИКА: сообщение на панели уведомлений доказывает, что скрипт
        // вообще стартовал (onGlobal вызвался, GRun выполнился). Если его нет
        // в новостях — скрипт не запущен, и дело не в типе станции.
        if (vProbe) {
            Ether(0, '', "SbHello: onGlobal -> GRun, скрипт запущен");
        }
    }
}
