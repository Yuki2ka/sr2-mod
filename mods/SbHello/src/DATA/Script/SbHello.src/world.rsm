// Мир скрипта. Star/planet нужны как контекст для RScript.
// Важно: ship(player:true) ниже задаёт условие запуска, но сам по себе не
// привязывает игрока к запущенному экземпляру скрипта. Экземпляр без связанных
// кораблей движок удаляет после хода. Поэтому SbGroup содержит только игрока:
// count=1 + addPlayer=true не создаёт дополнительных NPC.

// Звезда, в которой живёт скрипт (имя — для ссылок из этого же скрипта).
star("SbStar", {noKling: false, noComeKling: false});

planet("SbPlanet", {star: "SbStar", race: ["Maloc", "Peleng", "People", "Fei", "Gaal"], owner: ["Maloc", "Peleng", "People", "Fei", "Gaal"], economy: ["Agriculture", "Industrial", "Mixed"], government: ["Anarchy", "Dictatorship", "Monarchy", "Republic", "Democracy"], rangeMin: 0, rangeMax: 100});

// Требование к кораблю ИГРОКА (player: true): скрипт стартует, когда игрок
// под него подходит. Перечислены все обычные типы, чтобы подходил любой корабль.
ship({star: "SbStar", player: true, count: 1, owner: ["Maloc", "Peleng", "People", "Fei", "Gaal"], type: ["Ranger", "Warrior", "Pirate", "Transport", "Liner", "Diplomat"], speedMin: 0, speedMax: 10000, weapon: 0, cargoHook: 0, emptySpace: 0, statusTraderMin: 0, statusTraderMax: 100, statusWarriorMin: 0, statusWarriorMax: 100, statusPirateMin: 0, statusPirateMax: 100, strengthMin: 0, strengthMax: 0, ruins: ""});

// Ровно один участник группы — сам игрок. При addPlayer=true движок вычитает
// игрока из countMin прежде чем создавать NPC, поэтому здесь лишних кораблей нет.
group("SbGroup", {planet: "SbPlanet", state: "SbIdle", owner: ["Maloc", "Peleng", "People", "Fei", "Gaal"], type: ["Ranger"], countMin: 1, countMax: 1, speedMin: 100, speedMax: 10000, weapon: 0, cargoHook: 0, emptySpace: 0, addPlayer: true, statusTraderMin: 0, statusTraderMax: 100, statusWarriorMin: 0, statusWarriorMax: 100, statusPirateMin: 0, statusPirateMax: 100, distSearch: 10000, strengthMin: 0, strengthMax: 0, ruins: ""});
