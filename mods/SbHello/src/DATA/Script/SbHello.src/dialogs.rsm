// Диалог: dialog (вход и маршрутизация) -> dialogMsg (реплика NPC)
// -> dialogAnswer (ответ игрока).
//
// DChange/DAdd принимают и номер (по порядку объявления, с нуля), и имя.
// Здесь везде имена: правка порядка объявления тогда ничего не ломает.
//
// Текст реплик пишите ТОЛЬКО в text: — сборка сама кладёт его в Lang.dat.
// DText(CT("...")) внутри code: не пишите: rsmc портит такие вызовы
// (двойной CT) — это ловит `srmod lint`.
//
// В игровом тексте не используйте тире, кавычки-ёлочки и прочую типографику:
// в CP1251 они есть, но в bitmap-шрифтах SRHD их может не быть.

// --- Научная база --------------------------------------------------------

dialog("DialogSbHello", {code: function() {
    DChange('MsgSbHello');
    exit;
}});

dialogMsg("MsgSbHello", {text: "Главный научный советник откладывает зонд и поворачивается к вам.<br><br>Рейнджер, любопытно, что вы зашли. Мы как раз калибруем новый сенсорный массив. Если хотите, внесу ваш корабль в список приоритетных целей сканирования.", code: function() {
    DAdd('AnsSbHelloBack');
}});

// answerCommand: restart — корректный возврат в меню станции.
// fastexit в диалогах планет и станций работает ненадёжно, exit рвёт ветку.
dialogAnswer("AnsSbHelloBack", {text: "Спасибо, советник. Я на связи.", answerCommand: "restart"});

// --- Диагностика (включается vProbe = 1 в vars.rsm) ----------------------

dialog("DialogSbProbe", {code: function() {
    DChange('MsgSbProbe');
    exit;
}});

dialogMsg("MsgSbProbe", {text: "Диагностика SbHello.<br><br>Тип этой станции показан прямо в пункте меню, которым вы сюда попали. Если вместо SB видно другое значение, замените сравнение в code.rsm на него.<br><br>Там же видно start - ход, на котором создан текущий экземпляр скрипта, и now - текущий ход. Если start меньше 300, скрипт запущен при генерации партии (BV/OnStart). Если start равен ходу сохранения, экземпляр поднят при загрузке (BV/OnLoad), и новая игра для проверки правок не нужна.<br><br>Путь onGlobal сообщает о себе отдельной новостью: если она есть, основной запуск не сработал.", code: function() {
    DAdd('AnsSbProbeBack');
}});

dialogAnswer("AnsSbProbeBack", {text: "Понятно.", answerCommand: "restart"});
